# Copie para .env (na raiz do repositório) e preencha. O .env nunca vai para o Git.
# Em produção (Render, Railway...), cadastre as mesmas variáveis no painel do serviço.

# --- Banco PostgreSQL (Supabase ou local) ---
# Supabase: use o endereço do pooler (Project Settings → Database → Connection pooling),
# usuário postgres.<id-do-projeto>, e DB_SSLMODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=roommatch
DB_SSLMODE=prefer

# --- Autenticação (JWT) ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Site ---
# Origens que podem chamar a API (vírgula). O padrão já inclui https://silverwying.github.io.
# CORS_ORIGINS=https://silverwying.github.io,http://127.0.0.1:8765
# Endereço das páginas, usado nos links dos e-mails (recuperar senha, confirmar e-mail).
FRONTEND_URL=http://127.0.0.1:8765/frontend/pages

# --- E-mail (recuperação de senha e confirmação) ---
# Sem SMTP_HOST, os e-mails só aparecem no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RoomMatch <nao-responda@roommatch.app>

# --- Fotos dos anúncios ---
# local: pasta backend/uploads (some a cada deploy em hospedagem sem disco).
# supabase: bucket público no Supabase Storage (crie o bucket "imoveis" como público).
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=imoveis

# --- Ônibus (GTFS da EMDEC/EMTU) ---
# Um ou mais arquivos .zip (ou pastas) separados por vírgula. Vazio: sem rota de ônibus.
GTFS_PATHS=
GTFS_RAIO_CAMINHADA_M=1000
